{
    "rewrites": [
        {
            "source": "/api/proxy/feedbacks/(.*)",
            "destination": "https://crm.europecalling.co/api/feedbacks/$1"
        },
        {
            "source": "/api/proxy/feedbacks",
            "destination": "https://crm.europecalling.co/api/feedbacks/"
        },
        {
            "source": "/api/submit-form",
            "destination": "https://web.europecalling.co/submit-form.php"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}